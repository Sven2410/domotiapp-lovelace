{
  "name": "domotiapp-lovelace",
  "description": "Lovelace-kaarten van DomotiApp, geleverd door de gelijknamige integratie. De versie staat in custom_components/domotiapp_lovelace/manifest.json, niet hier.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/build.mjs --check",
    "watch": "node scripts/build.mjs --watch",
    "test": "node --test \"tests/js/**/*.test.mjs\"",
    "check:registratie": "node scripts/check-registratie.mjs",
    "check:controls": "node scripts/check-controls.mjs",
    "check:css": "node scripts/check-css.mjs"
  },
  "dependencies": {
    "lit": "3.3.1"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
